# Environment variables read by the backend. Every one has a default that works locally.
# DART_MODEL_DIR=artifacts/dart_v1.0      # folder of the exported model
# DART_DEVICE=cuda                         # cuda or cpu; default: cuda if available
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=dart
# CORS_ORIGINS=http://localhost:5173       # comma-separated origins allowed to call the API
# RATE_LIMIT_PER_MINUTE=60                 # per client; 0 disables
